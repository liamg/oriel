=== start
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus editor#round.go
=== ⌃W J: dock the terminal at the bottom (already there)
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus terminal#1
=== ⌃W L: split the terminal right of the focused file
main
  split h [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
dock left open=true [*explorer]
dock bottom open=true [*problems]
focus terminal#1
=== split the terminal below
main
  split v [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
dock left open=true [*explorer]
dock bottom open=true [*problems]
focus terminal#1
