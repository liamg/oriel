=== drop a tab on its own leaf's edge: splits it off
main
  split h [1 1]
    leaf [*editor#round.go]
    leaf [*editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus editor#round_test.go
=== drop a lone tab on its own leaf's edge: nothing
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus editor#round.go
=== drop on the left dock
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [explorer *problems]
dock bottom open=true [*terminal#1]
focus problems
=== drop on the right dock
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock right open=true [*problems]
dock bottom open=true [*terminal#1]
focus problems
=== drop in open space: a float there
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [*problems]
float 300,200 500x300 [*terminal#1]
focus terminal#1
=== split twice the same way: one split, three children
main
  split h [1 0.5 0.5]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
    leaf [*problems]
dock left open=true [*explorer]
focus problems
=== moving the last view out of a split collapses it
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus terminal#1
=== close the focused tab: focus goes to its neighbour
main
  leaf [*editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus editor#round_test.go
=== ⌃J: close the bottom dock
main
  leaf [*editor#round.go editor#round_test.go]
dock left open=true [*explorer]
dock bottom open=false [problems *terminal#1]
focus editor#round.go
=== ⌃W =: even out the splits
main
  split h [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
dock left open=true [*explorer]
dock bottom open=true [*problems]
focus terminal#1
