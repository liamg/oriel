main
  split h [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
dock left open=true [*explorer]
dock bottom open=true [*problems]
zoomed terminal#1
focus terminal#1
=== ⌃W Z again: the exact tree comes back
main
  split h [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*terminal#1]
dock left open=true [*explorer]
dock bottom open=true [*problems]
focus terminal#1
=== open something new as a split
main
  split h [1 1]
    leaf [*editor#round.go editor#round_test.go]
    leaf [*requests]
dock left open=true [*explorer]
dock bottom open=true [problems *terminal#1]
focus requests
