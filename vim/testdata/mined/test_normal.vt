=== Test_normal26_put #1
ref:    testdir/test_normal.vim#Test_normal26_put
given:
  while read LINE
  do
    ((count++))
    if \[ $? -ne 0 \]; then
      echo 'Error writing file'
    fi
  done
  |
keys:   :1<CR>:/Error/y a<CR>:2<CR>"a]pj"a[p
# cursor from oracle
# lines 1,6-10 from oracle
expect:
  while read LINE
  do
  echo 'Error writing file'
    |echo 'Error writing file'
    ((count++))
    if \[ $? -ne 0 \]; then
      echo 'Error writing file'
    fi
  done
  

=== Test_normal26_put #2
ref:    testdir/test_normal.vim#Test_normal26_put
given:
  while read LINE
  do
    ((count++))
    if \[ $? -ne 0 \]; then
      echo 'Error writing file'
    fi
  done
  |
keys:   :1<CR>:/Error/y a<CR>:2<CR>"a]pj"a[p:1<CR>:/^<Bslash>s<Bslash>{4}/<CR>"a]P3Eldt'j"a[P2Eldt'
# cursor from oracle
# lines 1-5,11-12 from oracle
expect:
  while read LINE
  do
  echo 'Error writing file'
    echo 'Error writing file'
    ((count++))
    if \[ $? -ne 0 \]; then
      echo 'Error writing'
      echo 'Error|'
      echo 'Error writing file'
    fi
  done
  

