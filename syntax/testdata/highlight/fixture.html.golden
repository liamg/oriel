   1 | <!DOCTYPE html>
     | ^^ tag.delimiter
     |   ^^^^^^^^^^^^^ constant
   2 | <html lang="en">
     | ^ tag.delimiter
     |  ^^^^ tag
     |       ^^^^ tag.attribute
     |           ^ operator
     |            ^^^^ string
     |                ^ tag.delimiter
   3 |   <head>
     |   ^ tag.delimiter
     |    ^^^^ tag
     |        ^ tag.delimiter
   4 |     <meta charset="utf-8">
     |     ^ tag.delimiter
     |      ^^^^ tag
     |           ^^^^^^^ tag.attribute
     |                  ^ operator
     |                   ^^^^^^^ string
     |                          ^ tag.delimiter
   5 |     <title>Oriel</title>
     |     ^ tag.delimiter
     |      ^^^^^ tag
     |           ^ tag.delimiter
     |            ^^^^^ markup.heading
     |                 ^^ tag.delimiter
     |                   ^^^^^ tag
     |                        ^ tag.delimiter
   6 |     <style>body { margin: 0; }</style>
     |     ^ tag.delimiter
     |      ^^^^^ tag
     |           ^ tag.delimiter
     |            ^^^^ tag
     |                 ^ punctuation.bracket
     |                   ^^^^^^ property
     |                         ^ punctuation.delimiter
     |                           ^ number
     |                            ^ punctuation.delimiter
     |                              ^ punctuation.bracket
     |                               ^^ tag.delimiter
     |                                 ^^^^^ tag
     |                                      ^ tag.delimiter
   7 |   </head>
     |   ^^ tag.delimiter
     |     ^^^^ tag
     |         ^ tag.delimiter
   8 |   <body>
     |   ^ tag.delimiter
     |    ^^^^ tag
     |        ^ tag.delimiter
   9 |     <!-- the app -->
     |     ^^^^^^^^^^^^^^^^ comment
  10 |     <main id="app" class="dark">Hello</main>
     |     ^ tag.delimiter
     |      ^^^^ tag
     |           ^^ tag.attribute
     |             ^ operator
     |              ^^^^^ string
     |                    ^^^^^ tag.attribute
     |                         ^ operator
     |                          ^^^^^^ string
     |                                ^ tag.delimiter
     |                                 ^^^^^ none
     |                                      ^^ tag.delimiter
     |                                        ^^^^ tag
     |                                            ^ tag.delimiter
  11 |     <script>console.log("ready");</script>
     |     ^ tag.delimiter
     |      ^^^^^^ tag
     |            ^ tag.delimiter
     |             ^^^^^^^ variable.builtin
     |                    ^ punctuation.delimiter
     |                     ^^^ function.method.call
     |                        ^ punctuation.bracket
     |                         ^^^^^^^ string
     |                                ^ punctuation.bracket
     |                                 ^ punctuation.delimiter
     |                                  ^^ tag.delimiter
     |                                    ^^^^^^ tag
     |                                          ^ tag.delimiter
  12 |   </body>
     |   ^^ tag.delimiter
     |     ^^^^ tag
     |         ^ tag.delimiter
  13 | </html>
     | ^^ tag.delimiter
     |   ^^^^ tag
     |       ^ tag.delimiter
