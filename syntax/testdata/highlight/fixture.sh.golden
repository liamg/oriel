     |        ^ variable
     |         ^^ punctuation.special
     |           ^^^^^ none
     |                ^ punctuation.special
   5 | for i in 1 2 3; do
     | ^^^ keyword.repeat
     |     ^ variable
     |       ^^ keyword.conditional
     |          ^ number
     |            ^ number
     |              ^ number
     |               ^ punctuation.delimiter
     |                 ^^ keyword.repeat
   6 | 	echo "hello $name ($i)"
     |  ^^^^ function.builtin
     |       ^^^^^^^ string
     |              ^ punctuation.special
     |               ^^^^ variable
     |                   ^^ string
     |                     ^ punctuation.special
     |                      ^ variable
     |                       ^^ string
   7 | done
     | ^^^^ keyword.repeat
   8 | 
   9 | if [[ -f "$HOME/.bashrc" ]]; then
     | ^^ keyword.conditional
     |    ^^ punctuation.bracket
     |       ^^ operator
     |          ^ string
     |           ^ punctuation.special
     |            ^^^^ variable.builtin
     |                ^^^^^^^^^ string
     |                          ^^ punctuation.bracket
     |                            ^ punctuation.delimiter
     |                              ^^^^ keyword.conditional
  10 | 	count=$(wc -l <"$HOME/.bashrc")
     |  ^^^^^ variable
