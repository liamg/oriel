     |                ^ operator
     |                 ^ string
     |                  ^ punctuation.special
     |                   ^^^^ variable.builtin
     |                       ^^^^^^^^^ string
     |                                ^ punctuation.special
  11 | 	printf '%s lines\n' "$count"
