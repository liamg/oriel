   1 | <template>
     | ^ tag.delimiter
     |  ^^^^^^^^ tag
     |          ^ tag.delimiter
   2 |   <ul class="tiers">
     |   ^ tag.delimiter
     |    ^^ tag
     |       ^^^^^ tag.attribute
     |            ^ operator
     |             ^^^^^^^ string
     |                    ^ tag.delimiter
   3 |     <li v-for="t in tiers" :key="t.name">{{ t.name }}: {{ price(t) }}</li>
     |     ^ tag.delimiter
     |      ^^ tag
     |         ^^^^^ tag.attribute
     |              ^ operator
     |               ^ punctuation.special
     |                ^ variable
     |                 ^ none
     |                  ^^ keyword.operator
     |                    ^ none
     |                     ^^^^^ variable
     |                          ^ punctuation.special
     |                            ^ character.special
     |                             ^^^ variable.member
     |                                ^ operator
     |                                 ^ punctuation.special
     |                                  ^ variable
     |                                   ^ punctuation.delimiter
     |                                    ^^^^ variable.member
     |                                        ^ punctuation.special
     |                                         ^ tag.delimiter
     |                                          ^^ punctuation.special
     |                                            ^ none
     |                                             ^ variable
     |                                              ^ punctuation.delimiter
     |                                               ^^^^ variable.member
     |                                                   ^ none
     |                                                    ^^ punctuation.special
     |                                                      ^^ none
     |                                                        ^^ punctuation.special
     |                                                          ^ none
     |                                                           ^^^^^ function.call
     |                                                                ^ punctuation.bracket
     |                                                                 ^ variable
     |                                                                  ^ punctuation.bracket
     |                                                                   ^ none
     |                                                                    ^^ punctuation.special
     |                                                                      ^^ tag.delimiter
     |                                                                        ^^ tag
     |                                                                          ^ tag.delimiter
   4 |   </ul>
     |   ^^ tag.delimiter
     |     ^^ tag
     |       ^ tag.delimiter
   5 | </template>
     | ^^ tag.delimiter
     |   ^^^^^^^^ tag
     |           ^ tag.delimiter
   6 | 
   7 | <script setup>
     | ^ tag.delimiter
     |  ^^^^^^ tag
     |         ^^^^^ tag.attribute
     |              ^ tag.delimiter
   8 | const tiers = [{ name: "basic", pence: 100 }, { name: "pro", pence: 450 }];
     | ^^^^^ keyword
     |       ^^^^^ variable
     |             ^ operator
     |               ^^ punctuation.bracket
     |                  ^^^^ variable.member
     |                      ^ punctuation.delimiter
     |                        ^^^^^^^ string
     |                               ^ punctuation.delimiter
     |                                 ^^^^^ variable.member
     |                                      ^ punctuation.delimiter
     |                                        ^^^ number
     |                                            ^ punctuation.bracket
     |                                             ^ punctuation.delimiter
     |                                               ^ punctuation.bracket
     |                                                 ^^^^ variable.member
     |                                                     ^ punctuation.delimiter
     |                                                       ^^^^^ string
     |                                                            ^ punctuation.delimiter
     |                                                              ^^^^^ variable.member
     |                                                                   ^ punctuation.delimiter
     |                                                                     ^^^ number
     |                                                                         ^^ punctuation.bracket
     |                                                                           ^ punctuation.delimiter
   9 | const price = (t) => (t.pence / 100).toFixed(2);
     | ^^^^^ keyword
     |       ^^^^^ function
     |             ^ operator
     |               ^ punctuation.bracket
     |                ^ variable.parameter
     |                 ^ punctuation.bracket
     |                   ^^ operator
     |                      ^ punctuation.bracket
     |                       ^ variable
     |                        ^ punctuation.delimiter
     |                         ^^^^^ variable.member
     |                               ^ operator
     |                                 ^^^ number
     |                                    ^ punctuation.bracket
     |                                     ^ punctuation.delimiter
     |                                      ^^^^^^^ function.method.call
     |                                             ^ punctuation.bracket
     |                                              ^ number
     |                                               ^ punctuation.bracket
     |                                                ^ punctuation.delimiter
  10 | </script>
     | ^^ tag.delimiter
     |   ^^^^^^ tag
     |         ^ tag.delimiter
  11 | 
  12 | <style scoped>
     | ^ tag.delimiter
     |  ^^^^^ tag
     |        ^^^^^^ tag.attribute
     |              ^ tag.delimiter
  13 | .tiers { color: #333; }
     | ^ punctuation.delimiter
     |  ^^^^^ type
     |        ^ punctuation.bracket
     |          ^^^^^ property
     |               ^ punctuation.delimiter
     |                 ^ punctuation.delimiter
     |                  ^^^ string
     |                     ^ punctuation.delimiter
     |                       ^ punctuation.bracket
  14 | </style>
     | ^^ tag.delimiter
     |   ^^^^^ tag
     |        ^ tag.delimiter
