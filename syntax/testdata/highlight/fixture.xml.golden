   1 | <?xml version="1.0" encoding="UTF-8"?>
     | ^^ tag.delimiter
     |   ^^^ keyword.directive
     |       ^^^^^^^ tag.attribute
     |              ^ operator
     |               ^ punctuation.delimiter
     |                ^^^ number
     |                   ^ punctuation.delimiter
     |                     ^^^^^^^^ tag.attribute
     |                             ^ operator
     |                              ^ punctuation.delimiter
     |                               ^^^^^ string.special
     |                                    ^ punctuation.delimiter
     |                                     ^^ tag.delimiter
   2 | <!-- Pricing tiers. -->
     | ^^^^^^^^^^^^^^^^^^^^^^^ comment
   3 | <tiers xmlns="https://example.com/pricing" currency="GBP">
     | ^ tag.delimiter
     |  ^^^^^ tag
     |        ^^^^^ tag.attribute
     |             ^ operator
     |              ^ punctuation.delimiter
     |               ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string
     |                                          ^ punctuation.delimiter
     |                                            ^^^^^^^^ tag.attribute
     |                                                    ^ operator
     |                                                     ^ punctuation.delimiter
     |                                                      ^^^ string
     |                                                         ^ punctuation.delimiter
     |                                                          ^ tag.delimiter
   4 |   <tier name="basic">
     | ^^ none
     |   ^ tag.delimiter
     |    ^^^^ tag
     |         ^^^^ tag.attribute
     |             ^ operator
     |              ^ punctuation.delimiter
     |               ^^^^^ string
     |                    ^ punctuation.delimiter
     |                     ^ tag.delimiter
   5 |     <pence>100</pence>
     | ^^^^ none
     |     ^ tag.delimiter
     |      ^^^^^ tag
     |           ^ tag.delimiter
     |            ^^^ none
     |               ^^ tag.delimiter
     |                 ^^^^^ tag
     |                      ^ tag.delimiter
   6 |     <feature>email</feature>
