     |                     ^^^^^^^ tag
     |                            ^ tag.delimiter
   7 |   </tier>
     | ^^ none
     |   ^^ tag.delimiter
     |     ^^^^ tag
     |         ^ tag.delimiter
   8 |   <tier name="pro">
     | ^^ none
     |   ^ tag.delimiter
     |    ^^^^ tag
